# =============================================================================
# LLM
# =============================================================================
OPENAI_API_KEY=sk-...

# Model (defaults to gpt-4o-mini). Bump to gpt-4o for higher-quality generation.
MODEL_NAME=gpt-4o-mini

# =============================================================================
# LangSmith tracing (optional but strongly recommended)
# =============================================================================
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=unit_test_generator_agent

# =============================================================================
# GitHub
# =============================================================================
# Personal access token OR GitHub App token with: repo, pull_request:write
GITHUB_TOKEN=
# Shared secret configured in the GitHub webhook settings (used for HMAC verify)
GITHUB_WEBHOOK_SECRET=

# =============================================================================
# GitLab
# =============================================================================
GITLAB_URL=https://gitlab.com
# Personal access token with: api, write_repository
GITLAB_TOKEN=
# Value of the "Secret Token" field in the webhook UI
GITLAB_WEBHOOK_SECRET=

# =============================================================================
# Bitbucket Cloud
# =============================================================================
BITBUCKET_USERNAME=
# App password with: pullrequest:write, repository:write
BITBUCKET_APP_PASSWORD=
# Optional shared secret sent as X-Hook-Secret header (custom convention)
BITBUCKET_WEBHOOK_SECRET=

# =============================================================================
# Behavior tuning
# =============================================================================
WORKSPACE_DIR=/tmp/testgen-workspaces
MAX_FILES_PER_PR=20
MAX_FILE_LOC=2000
MAX_ATTEMPTS=3
